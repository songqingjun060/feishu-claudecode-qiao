FEISHUCLAUDECODE_FEISHU_APP_ID=cli_xxxxx
FEISHUCLAUDECODE_FEISHU_APP_SECRET=xxxxx

# Kimi Coding Anthropic-compatible vision example
FEISHUCLAUDECODE_VISION_API_KEY=your-kimi-coding-key
FEISHUCLAUDECODE_VISION_BASE_URL=https://api.kimi.com/coding/
FEISHUCLAUDECODE_VISION_MODEL=kimi-for-coding

FEISHUCLAUDECODE_CLAUDE_COMMAND=claude
FEISHUCLAUDECODE_CLAUDE_WORK_DIR=.
FEISHUCLAUDECODE_CLAUDE_PERMISSION_MODE=safe

FEISHUCLAUDECODE_BRIDGE_DATA_DIR=./data
FEISHUCLAUDECODE_BRIDGE_LOG_LEVEL=INFO
FEISHUCLAUDECODE_BRIDGE_REQUIRE_MENTION_IN_GROUP=true

FEISHUCLAUDECODE_SECURITY_ALLOWED_PATHS=D:/project,D:/docs
FEISHUCLAUDECODE_SECURITY_BLOCKED_KEYWORDS=password,secret,token
